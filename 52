import pandas as pd
import json
import os
import requests  # Assuming your company host provides a standard REST API

# ==========================================
# STAGE 1: INGESTION & QUANTITATIVE MATH
# ==========================================
OPTIMIZED_PARQUET_PATH = "bertopic_optimized_llm_payload.parquet"
MARKDOWN_OUTPUT_PATH = "AML_Topic_Analysis_Report.md"

# Load the optimized table
df_payload = pd.read_parquet(OPTIMIZED_PARQUET_PATH)

# Calculate global quantitative volume
TOTAL_ALERTS_PROCESSED = df_payload['Cluster_Size'].sum()
df_payload['Volume_Percentage'] = (df_payload['Cluster_Size'] / TOTAL_ALERTS_PROCESSED) * 100

print(f"Total Base Alerts Aggregated: {TOTAL_ALERTS_PROCESSED:,}")
print(f"Total Unique Automated Clusters to Process: {len(df_payload)}")

# ==========================================
# STAGE 2: INITIALIZE MARKDOWN REPORT FILE
# ==========================================
# Create or overwrite the file with an executive header
with open(MARKDOWN_OUTPUT_PATH, "w", encoding="utf-8") as f:
    f.write("# Executive AML False-Positive Topic Analysis Report\n")
    f.write(f"**Total Historical Alerts Analyzed:** {TOTAL_ALERTS_PROCESSED:,}\n")
    f.write(f"**Total Distinct Behavioral Vectors Found:** {len(df_payload)}\n")
    f.write("---\n\n")
    f.write("## Discovered Compliance Topics & Quantitative Breakdown\n\n")
    # Write the table headers
    f.write("| Bucket ID | Core Topic Name | Alert Volume | Volume % | Analytical Description |\n")
    f.write("|---|---|---|---|---|\n")

# ==========================================
# STAGE 3: CHUNKING & LLM ORCHESTRATION
# ==========================================
def call_company_llm(system_prompt, user_prompt):
    """
    Wrapper function for your company's hosted gpt-oss-120b instance.
    Modify headers and payload parameters to match your company's internal API gateway.
    """
    API_URL = "http://your-internal-llm-gateway/v1/chat/completions"
    headers = {
        "Authorization": f"Bearer {os.getenv('INTERNAL_LLM_KEY', 'mock-key')}",
        "Content-Type": "application/json"
    }
    
    payload = {
        "model": "gpt-oss-120b",
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "temperature": 0.1,  # Set very low for deterministic, strict JSON output
        "response_format": {"type": "json_object"}  # Enforce JSON if your gateway supports it
    }
    
    try:
        response = requests.post(API_URL, json=payload, headers=headers, timeout=60)
        response.raise_for_status()
        return response.json()['choices'][0]['message']['content']
    except Exception as e:
        print(f"API Error encountered: {e}")
        return None

# Definitive Corporate Persona & Instructions
SYSTEM_PROMPT = """You are an expert system serving as a Senior AML Compliance Director.
Your task is to analyze the provided batches of clustered transaction alert notes and assign precise, industry-standard corporate topics and descriptions.

For each bucket provided in the prompt, you must extract:
1. Topic_Name: A 3-to-5 word professional compliance label (e.g., "Legitimate Corporate Payroll", "Inter-Account Self-Transfers").
2. Description: A concise 1-to-2 sentence functional summary explaining why these alerts are false positives.

CRITICAL CONSTRAINTS:
- You must output your response STRICTLY as a valid JSON object containing an array named 'topics'.
- Do not add text before or after the JSON block.

Expected Output Schema:
{
  "topics": [
    {
      "Bucket_ID": 1,
      "Topic_Name": "Example Topic Name",
      "Description": "Detailed overview sentence."
    }
  ]
}"""

# Process in mini-batches of 10 clusters to maintain high focus inside the context window
BATCH_SIZE = 10

for i in range(0, len(df_payload), BATCH_SIZE):
    batch_df = df_payload.iloc[i:i+BATCH_SIZE]
    print(f"Processing Cluster Batch: {i} to {i+len(batch_df)}...")
    
    # Construct the User Query Context
    user_prompt_builder = "Analyze the following cluster groups and generate names/descriptions based on their vocabulary and sample contexts:\n\n"
    
    for _, row in batch_df.iterrows():
        user_prompt_builder += f"### Group ID: {row['Bucket_ID']}\n"
        user_prompt_builder += f"{row['Payload_For_LLM']}\n\n"
        
    # Execute API Call to gpt-oss-120b
    raw_llm_response = call_company_llm(SYSTEM_PROMPT, user_prompt_builder)
    
    if raw_llm_response:
        try:
            # Parse the structured response
            parsed_json = json.loads(raw_llm_response)
            
            # Open the live markdown ledger and stream the results instantly
            with open(MARKDOWN_OUTPUT_PATH, "a", encoding="utf-8") as f:
                for topic_data in parsed_json.get('topics', []):
                    b_id = topic_data['Bucket_ID']
                    
                    # Match back to our dataframe to extract our exact pre-calculated math
                    meta_row = df_payload[df_payload['Bucket_ID'] == b_id].iloc[0]
                    vol = meta_row['Cluster_Size']
                    pct = meta_row['Volume_Percentage']
                    
                    # Escape vertical bars to prevent breaking markdown tables
                    clean_desc = topic_data['Description'].replace("|", "-")
                    
                    # Append row directly to file
                    f.write(f"| {b_id} | **{topic_data['Topic_Name']}** | {vol:,} | {pct:.2f}% | {clean_desc} |\n")
                    
        except json.JSONDecodeError:
            print(f"CRITICAL: Failed to parse JSON for batch index {i}. Logging raw output for manual review.")
            with open("failed_raw_batches.txt", "a") as err_log:
                err_log.write(f"--- Batch {i} Fail ---\n{raw_llm_response}\n\n")

print(f"\nPipeline Execution Complete! Your production report is live at: '{MARKDOWN_OUTPUT_PATH}'")
