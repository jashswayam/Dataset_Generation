# ==========================================
# STAGE 1: DEPENDENCY INITIALIZATION
# ==========================================
import os
import re
import pandas as pd
import numpy as np
from bs4 import BeautifulSoup

# Vectorization, Matrix Math & Clustering
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.decomposition import TruncatedSVD
from sklearn.metrics.pairwise import cosine_similarity
import hdbscan

# Clean execution settings
import warnings
warnings.filterwarnings('ignore')

# ==========================================
# STAGE 2: DATA INGESTION & VIEW SCHEMA
# ==========================================
PARQUET_PATH = "your_300k_alerts.parquet"

print("--- Step 1: Ingesting Parquet Data ---")
# Using pandas with pyarrow engine for ultra-fast parquet reading
df = pd.read_parquet(PARQUET_PATH, engine='pyarrow')

print("\n--- Step 2: Verifying Data Schema ---")
print(df.info())
print(f"\nInitial row count: {len(df):,}")

# ==========================================
# STAGE 3: DATA SANITIZATION & DEDUPLICATION
# ==========================================
print("\n--- Step 3: Executing Surgical HTML Cleaning ---")

def extract_and_clean_blue_tag(html_content):
    """
    Surgically isolates text from the blue tag inside the HTML structure
    and standardizes text layout while preserving negation syntax.
    """
    if pd.isna(html_content) or not isinstance(html_content, str):
        return ""
    
    # Fast HTML Parsing
    soup = BeautifulSoup(html_content, 'html.parser')
    
    # Target elements using inline styles or specific class keywords matching your template
    blue_elements = soup.find_all(lambda tag: tag.name in ['div', 'span', 'td', 'th', 'p'] and 
                                 ('background-color: blue' in str(tag.get('style')) or 
                                  'blue' in str(tag.get('class'))))
    
    if blue_elements:
        text = " ".join([elem.get_text(separator=" ", strip=True) for elem in blue_elements])
    else:
        # Fallback to text matching headers if style tags are stripped
        text = ""
        for header in soup.find_all(['b', 'strong', 'td']):
            if "analysis" in header.text.lower() or "conclusion" in header.text.lower():
                next_node = header.next_sibling
                if next_node:
                    text = next_node.get_text(strip=True)
                    break
        if not text:
            text = soup.get_text(separator=" ", strip=True)
            
    # Text standardization pipeline
    text = text.lower()
    text = re.sub(r'\s+', ' ', text)  # Collapse white spaces and newlines
    text = re.sub(r'[^a-zA-Z\s\.\,\-\;]', '', text)  # Keep basic structural punctuation
    return text.strip()

# Apply the parsing engine
df['cleaned_note'] = df['note'].apply(extract_and_clean_blue_tag)

# Filter empty notes immediately
df = df[df['cleaned_note'] != ""].reset_index(drop=True)

print("\n--- Step 4: Executing Aggressive Deduplication ---")
# L1 investigators copy/paste standard template phrases. This eliminates duplicate footprints.
initial_count = len(df)
dedup_df = df.drop_duplicates(subset=['Rule_ID', 'cleaned_note']).reset_index(drop=True)
final_count = len(dedup_df)

print(f"Rows before deduplication: {initial_count:,}")
print(f"Rows after deduplication:  {final_count:,}")
print(f"Compressed dataset by {((initial_count - final_count) / initial_count) * 100:.2f}% using pure text filtering.")

# ==========================================
# STAGE 4: LOCAL TEXT FEATURIZATION (CPU)
# ==========================================
print("\n--- Step 5: Constructing Vector Workspace ---")

from sklearn.feature_extraction import text
standard_stop_words = list(text.ENGLISH_STOP_WORDS)

# CRITICAL COMPLIANCE STRIP: Keep negations intact so meaning isn't flipped
negations_to_keep = {'no', 'not', 'nor', 'neither', 'none', 'nothing', 'never', 'without'}
custom_stop_words = [word for word in standard_stop_words if word not in negations_to_keep]

# Add internal banking/system domain noise
domain_noise = ['alert', 'transaction', 'customer', 'account', 'party', 'reviewed', 'investigation', 'closed']
custom_stop_words.extend(domain_noise)

# Max_df=0.85 dynamically excludes boilerplate words appearing in more than 85% of documents
vectorizer = TfidfVectorizer(stop_words=custom_stop_words, max_df=0.85, min_df=5, ngram_range=(1, 2))
tfidf_matrix = vectorizer.fit_transform(dedup_df['cleaned_note'])

print(f"Sparse Feature Matrix Shape: {tfidf_matrix.shape}")

print("\n--- Step 6: Diminishing Dimensionality (LSA) ---")
# Compress sparse word vectors into dense context profiles (resolves synonym issues)
svd = TruncatedSVD(n_components=30, random_state=42)
lsa_matrix = svd.fit_transform(tfidf_matrix)

print(f"Dense Context Matrix Shape: {lsa_matrix.shape}")

# ==========================================
# STAGE 5: LIGHTWEIGHT TOPIC CLUSTERING
# ==========================================
print("\n--- Step 7: Performing HDBSCAN Math Clustering ---")
# min_cluster_size: Minimum number of notes to constitute an independent system problem/reason
clusterer = hdbscan.HDBSCAN(min_cluster_size=10, min_samples=3, metric='euclidean', prediction_data=True)
dedup_df['Topic_Cluster'] = clusterer.fit_predict(lsa_matrix)

cluster_counts = dedup_df['Topic_Cluster'].value_counts()
total_clusters = len(cluster_counts) - (1 if -1 in cluster_counts else 0)
print(f"Discovered {total_clusters} distinct mathematical clusters across your dataset.")

# ==========================================
# STAGE 6: REPRESENTATIVE NOTE EXTRACTION (THE LLM SAVIOR)
# ==========================================
print("\n--- Step 8: Isolating Core Cluster Centroids ---")

# We will sample the top 5 most representative notes closest to each cluster center
NUM_SAMPLES_PER_CLUSTER = 5
llm_payload_records = []

unique_clusters = [c for c in dedup_df['Topic_Cluster'].unique() if c != -1]

for cluster_id in unique_clusters:
    # 1. Isolate the row indices of the elements inside this cluster
    cluster_indices = dedup_df[dedup_df['Topic_Cluster'] == cluster_id].index.tolist()
    
    # 2. Extract the corresponding sub-matrix of dense vectors
    cluster_vectors = lsa_matrix[cluster_indices]
    
    # 3. Calculate the true mathematical center (mean vector) of this cluster
    cluster_centroid = cluster_vectors.mean(axis=0).reshape(1, -1)
    
    # 4. Measure proximity/similarity of every note in the cluster to its center
    similarities = cosine_similarity(cluster_vectors, cluster_centroid).flatten()
    
    # 5. Extract top N indexes with highest similarity matching scores
    top_local_indices = similarities.argsort()[::-1][:NUM_SAMPLES_PER_CLUSTER]
    top_global_indices = [cluster_indices[idx] for idx in top_local_indices]
    
    # 6. Gather original un-cleaned notes for LLM context verification
    representative_notes = dedup_df.loc[top_global_indices, 'cleaned_note'].tolist()
    associated_alerts = dedup_df.loc[top_global_indices, 'alert_id'].tolist()
    associated_units = dedup_df.loc[top_global_indices, 'bunit_identifier'].tolist()
    
    # Format a single composite row per cluster for your LLM loop
    llm_payload_records.append({
        "Topic_Cluster_ID": cluster_id,
        "Cluster_Total_Alert_Volume": len(cluster_indices),
        "Sample_Alert_IDs": associated_alerts,
        "Sample_Business_Units": list(set(associated_units)),
        "Combined_Representative_Text": " |OR| ".join([f"Note {i+1}: {text}" for i, text in enumerate(representative_notes)])
    })

# Convert payload vectors to target analysis dataframe
llm_input_df = pd.DataFrame(llm_payload_records)

# ==========================================
# STAGE 7: ANALYTICAL OUTPUT ANALYSIS
# ==========================================
print("\n=== TOPIC ENGINEERING CONVERSION COMPLETE ===")
print(f"Original Row Inventory Dimension: {len(df):,}")
print(f"Optimized Downstream Target Dataframe Dimension: {len(llm_input_df)} rows.")
print(f"Total workload savings: You only need to query your LLM {len(llm_input_df)} times instead of 300,000 times.")

print("\n--- Final Output Dataset Preview (Ready for LLM loop Processing) ---")
# Preview columns optimized for LLM prompting
print(llm_input_df[['Topic_Cluster_ID', 'Cluster_Total_Alert_Volume', 'Combined_Representative_Text']].head(5))

# Exporting payload matrix safely
llm_input_df.to_parquet("optimized_llm_input_payload.parquet")
